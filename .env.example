APP_NAME=aotu-gpt
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://aotu_gpt:zhh123456@127.0.0.1:5432/aotu_gpt
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
REDIS_URL=redis://127.0.0.1:6379/0
ENABLE_STARTUP_DB_INIT=true
ENABLE_BACKGROUND_WORKERS=true
ASYNC_REQUEST_LOG_ENABLED=true
REQUEST_LOG_QUEUE_WORKER_COUNT=2
REQUEST_LOG_QUEUE_BATCH_SIZE=100
REQUEST_LOG_INGRESS_QUEUE_SIZE=20000
CACHE_L1_TTL_CAP_SECONDS=1
API_KEY_AUTH_CACHE_TTL_SECONDS=60
API_KEY_AUTH_L1_CACHE_TTL_SECONDS=1
API_KEY_AUTH_USAGE_INVALIDATE_INTERVAL_MS=0
CONCURRENCY_LEASE_TTL_SECONDS=900
GLOBAL_MAX_ACTIVE_REQUESTS=1000
GLOBAL_MAX_ACTIVE_STREAMS=300
API_KEY_MAX_ACTIVE_REQUESTS=50
API_KEY_MAX_ACTIVE_STREAMS=10
ACCOUNT_MAX_ACTIVE_REQUESTS=100
ACCOUNT_MAX_ACTIVE_STREAMS=20
PROVIDER_MAX_ACTIVE_REQUESTS=300
PROVIDER_MAX_ACTIVE_STREAMS=150
ROUTE_CAPACITY_PREFILTER_ENABLED=false
TOKEN_FINALIZE_WORKER_COUNT=2
TOKEN_FINALIZE_QUEUE_SIZE=10000
PROVIDER_SUCCESS_UPDATE_INTERVAL_MS=1000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=75
GUNICORN_GRACEFUL_TIMEOUT=30
REQUEST_TIMEOUT_MS=60000
UPSTREAM_JSON_CLIENT=aiohttp
UPSTREAM_STREAM_CLIENT=aiohttp
WORKER_THREADPOOL_TOKENS=200
STREAM_CONNECT_TIMEOUT_SECONDS=10
STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=60
STREAM_IDLE_TIMEOUT_SECONDS=120
STREAM_MAX_DURATION_SECONDS=600
UPSTREAM_MAX_CONNECTIONS=1200
UPSTREAM_MAX_KEEPALIVE_CONNECTIONS=300
UPSTREAM_POOL_TIMEOUT_S=10
LOCAL_PROXY_API_KEY=
EXTERNAL_BASE_URL=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
SESSION_SECRET_KEY=change-this-session-secret
API_KEY_ENCRYPTION_SECRET=change-this-api-key-encryption-secret
